# Database PostgreSQL (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NextAuth (required)
NEXTAUTH_SECRET="<your-nextauth-secret>"
NEXTAUTH_URL="https://your-domain.com"

# Public site URL (used for email links, Stripe redirects)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Stripe (required for payments)
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (required for emails)
RESEND_API_KEY="re_..."
EMAIL_FROM="MyGesp <onboarding@resend.dev>"

# Vercel Blob (required for image uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 2FA encryption key (required)
TOTP_ENCRYPTION_KEY="<32-byte-base64>"

# Optional: Upstash Redis for rate limiting in production
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
