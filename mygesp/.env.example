# ─────────────────────────────────────────────────────────────
# MyGesp — variabili d'ambiente
# Copia questo file in `.env.local` e compila i valori reali.
# Senza queste variabili l'app parte ma le funzioni che ne
# dipendono (pagamenti, email, upload) restituiscono errore.
# ─────────────────────────────────────────────────────────────

# Database PostgreSQL (obbligatoria)
DATABASE_URL="postgresql://utente:password@localhost:5432/mygesp?schema=public"

# Auth.js / NextAuth (obbligatorie)
# Auth.js v5 legge AUTH_SECRET; NEXTAUTH_SECRET resta supportata dal codice.
# Usa lo stesso valore per entrambe (o solo AUTH_SECRET + AUTH_URL).
AUTH_SECRET="genera-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# URL pubblico usato per link email e redirect Stripe
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (obbligatorie per i pagamenti)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Ottenuto da `stripe listen` o dalla dashboard → Webhook → signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (obbligatoria per le email)
RESEND_API_KEY="re_..."
EMAIL_FROM="MyGesp <onboarding@resend.dev>"

# Vercel Blob (obbligatoria per l'upload immagini prodotti)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Chiave per cifrare i segreti 2FA (totpSecret) a riposo.
# Se assente viene usata NEXTAUTH_SECRET. Genera con: openssl rand -base64 32
TOTP_ENCRYPTION_KEY="genera-con-openssl-rand-base64-32"

# Rate limiting distribuito (opzionale ma consigliato in produzione).
# Senza queste variabili il rate limiter usa la memoria del processo
# (su Vercel ogni istanza ha il proprio contatore).
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="token-upstash"
